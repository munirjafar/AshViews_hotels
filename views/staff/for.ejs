<form action="/staffs/create"
      method="POST"
      enctype="multipart/form-data"
      id="staffForm">

<!-- ================= STAFF INFO ================= -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-primary text-white">
        <h4>
            <ion-icon name="person-outline"></ion-icon>
            Staff Information
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 form-group">
                <label>Staff ID</label>

                <input type="text"
                       class="form-control"
                       value="<%= generatedStaffId %>"
                       readonly>

                <small class="text-muted">
                    Auto-generated by system
                </small>
            </div>

            <div class="col-md-4 form-group">
                <label>Full Name *</label>

                <input type="text"
                       id="fullname"
                       name="fullname"
                       class="form-control"
                       required>

                <small class="validation-error"></small>
            </div>

            <div class="col-md-4 form-group">
                <label>Gender *</label>

                <select id="gender"
                        name="gender"
                        class="form-control"
                        required>

                    <option value="">Select Gender</option>
                    <option>Male</option>
                    <option>Female</option>

                </select>

                <small class="validation-error"></small>
            </div>

        </div>

    </div>
</div>

<!-- ================= CONTACT ================= -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h4>
            <ion-icon name="call-outline"></ion-icon>
            Contact Information
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 form-group">
                <label>Mobile *</label>

                <input type="tel"
                       id="mobile"
                       name="mobile"
                       class="form-control"
                       required>

                <small class="validation-error"></small>
            </div>

            <div class="col-md-6 form-group">
                <label>Email *</label>

                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       required>

                <small class="validation-error"></small>
            </div>

        </div>

        <div class="form-group">
            <label>Address *</label>

            <textarea id="address"
                      name="address"
                      class="form-control"
                      rows="3"
                      required></textarea>

            <small class="validation-error"></small>
        </div>

    </div>
</div>

<!-- ================= EMPLOYMENT ================= -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h4>
            <ion-icon name="briefcase-outline"></ion-icon>
            Employment Details
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 form-group">
                <label>Role *</label>

                <select name="role"
                        class="form-control"
                        required>

                    <option value="">Select Role</option>
                    <option>Administrator</option>
                    <option>Manager</option>
                    <option>Receptionist</option>
                    <option>Housekeeping</option>
                    <option>Security</option>
                    <option>Accountant</option>

                </select>
            </div>

            <div class="col-md-4 form-group">
                <label>Status</label>

                <select name="status" class="form-control">
                    <option>Active</option>
                    <option>Inactive</option>
                    <option>Suspended</option>
                </select>
            </div>

            <div class="col-md-4 form-group">
                <label>Employment Date</label>

                <input type="date"
                       name="employment_date"
                       class="form-control">
            </div>

        </div>

    </div>
</div>

<!-- ================= DOCUMENTS ================= -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h4>
            <ion-icon name="document-attach-outline"></ion-icon>
            Documents
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 form-group">
                <label>Profile Photo</label>

                <input type="file"
                       name="photo"
                       accept="image/*"
                       class="form-control-file">
            </div>

            <div class="col-md-6 form-group">
                <label>CV Upload</label>

                <input type="file"
                       name="cv"
                       accept=".pdf,.doc,.docx"
                       class="form-control-file">
            </div>

        </div>

    </div>
</div>

<!-- ================= EMERGENCY ================= -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h4>
            <ion-icon name="medkit-outline"></ion-icon>
            Emergency Contact
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 form-group">
                <label>Contact Name</label>

                <input type="text"
                       name="emergency_name"
                       class="form-control">
            </div>

            <div class="col-md-6 form-group">
                <label>Contact Phone</label>

                <input type="text"
                       name="emergency_phone"
                       class="form-control">
            </div>

        </div>

    </div>
</div>

<!-- ================= SUBMIT ================= -->
<div class="text-right mb-5">

    <button type="reset" class="btn btn-secondary">
        <ion-icon name="refresh-outline"></ion-icon>
        Reset
    </button>

    <button type="submit"
            id="submitBtn"
            class="btn btn-primary">

        <span id="btnText">
            <ion-icon name="save-outline"></ion-icon>
            Create Staff
        </span>

        <span id="btnLoader" style="display:none;">
            <span class="spinner-border spinner-border-sm"></span>
            Creating...
        </span>

    </button>

</div>

</form>
<script>
document.addEventListener("DOMContentLoaded", () => {

    const form = document.getElementById("staffForm");

    const fullname = document.getElementById("fullname");
    const email = document.getElementById("email");
    const mobile = document.getElementById("mobile");

    const submitBtn = document.getElementById("submitBtn");
    const btnText = document.getElementById("btnText");
    const btnLoader = document.getElementById("btnLoader");

    function error(input, message) {
        input.classList.add("is-invalid");
        input.classList.remove("is-valid");

        const msg = input.parentElement.querySelector(".validation-error");
        if (msg) msg.textContent = message;
    }

    function success(input) {
        input.classList.remove("is-invalid");
        input.classList.add("is-valid");

        const msg = input.parentElement.querySelector(".validation-error");
        if (msg) msg.textContent = "";
    }

    // Full Name
    fullname.addEventListener("input", () => {
        fullname.value.trim().length < 3
            ? error(fullname, "Minimum 3 characters required")
            : success(fullname);
    });

    // Email
    email.addEventListener("input", () => {
        const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        !regex.test(email.value.trim())
            ? error(email, "Enter a valid email address")
            : success(email);
    });

    // Mobile
    mobile.addEventListener("input", () => {
        const digits = mobile.value.replace(/\D/g, '');
        digits.length < 10
            ? error(mobile, "Phone number is too short")
            : success(mobile);
    });

    // Submit
    form.addEventListener("submit", (e) => {

        if (document.querySelectorAll(".is-invalid").length > 0) {
            e.preventDefault();
            return;
        }

        submitBtn.disabled = true;
        btnText.style.display = "none";
        btnLoader.style.display = "inline-block";
    });

});
</script>
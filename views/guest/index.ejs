<h1 class="text-2xl font-bold mb-4 flex items-center gap-2">
  <ion-icon name="people-outline"></ion-icon> Guest List
</h1>
<div class="mb-4">
  <a href="/guests/new" class="bg-teal-600 text-white px-4 py-2 rounded hover:bg-teal-700">+ New Guest</a>
</div>
<div class="overflow-x-auto">
  <table class="min-w-full bg-white border">
    <thead>
      <tr><th class="py-2 px-3 border-b">ID</th><th class="py-2 px-3 border-b">Full Name</th><th class="py-2 px-3 border-b">Email</th><th class="py-2 px-3 border-b">Mobile</th><th class="py-2 px-3 border-b">Gender</th><th class="py-2 px-3 border-b">Actions</th></tr>
    </thead>
    <tbody>
      <% guests.forEach(g => { %>
        <tr><td class="py-2 px-3 border-b"><%= g.id %></td>
          <td class="py-2 px-3 border-b"><%= g.fullname %></td>
          <td class="py-2 px-3 border-b"><%= g.email %></td>
          <td class="py-2 px-3 border-b"><%= g.mobile %></td>
          <td class="py-2 px-3 border-b"><%= g.gender || '-' %></td>
          <td class="py-2 px-3 border-b">
            <a href="/guests/<%= g.id %>/edit" class="text-blue-600 mr-2">Edit</a>
            <form method="POST" action="/guests/<%= g.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete guest?')">
              <button type="submit" class="text-red-600">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'ProUSB Card System' %></title>
      <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/source-sans-3@5.0.12/index.css"
      integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q="
      crossorigin="anonymous"
      media="print"
      onload="this.media = 'all'"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" crossorigin="anonymous">   
    <link rel="stylesheet" href="/css/index.css?v=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.1/dist/css/adminlte.min.css">
</head>

<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">
                <%- include('pertials/topnavbar') %>
                <%- include('pertials/sidebar') %>
                <div class="content-wrapper px-4 py-2">
                        <% if (flash && (flash.success.length || flash.error.length)) { %>
                            <div class="container-fluid mt-2">
                                <% if (flash.success && flash.success.length) { %>
                                    <% flash.success.forEach(function(msg){ %>
                                        <div class="alert alert-success alert-dismissible">
                                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                                            <%= msg %>
                                        </div>
                                    <% }) %>
                                <% } %>
                                <% if (flash.error && flash.error.length) { %>
                                    <% flash.error.forEach(function(msg){ %>
                                        <div class="alert alert-danger alert-dismissible">
                                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                                            <%= msg %>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        <% } %>
                        <%- body %>
                </div>
       <%- include('pertials/footer') %>
    </div>
 <%- include('pertials/foot') %>
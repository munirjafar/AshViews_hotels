


        
    <!-- 
        We're using AdminLTE structure but customizing the card container.
        AdminLTE's '.login-box' class would normally wrap, but we keep 
        full control with flex centering while keeping all CSS non-duplicate.
        The card uses AdminLTE utility classes but we also add our custom class.
    -->
    <div class="card card-custom shadow-lg">
        <div class="card-body login-card-body p-4 p-md-5">
            <!-- brand section -->
            <div class="text-center mb-3">
                <h2 class="brand-heading">
                    AshView Accommodation
                </h2>
                <hr class="custom-divider">
                <p class="text-muted small mt-2 mb-0">Secure access to dashboard</p>
            </div>

            <!-- Flash message partial simulation (keeps original PHP include logic but markup compatible) -->
            <!-- NOTE: Original includes VIEW_PATH . '_partials/flash_message.php'; we keep same container for seamless integration -->
            <div id="flashMessageContainer">
                                <!-- This container allows dynamic flash from server; if no flash nothing shows -->
            </div>

            <!-- Login Form -->
            <form method="POST" id="loginForm" action="">
                <!-- Email field - using AdminLTE input group but with custom modifier class for consistency -->
                <div class="input-group mb-3 input-group-custom">
                    <input type="email" 
                           name="email" 
                           class="form-control" 
                           placeholder="Email address" 
                           autocomplete="email"
                           >
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </div>
                    </div>
                </div>

                <!-- Password field -->
                <div class="input-group mb-4 input-group-custom">
                    <input type="password" 
                           name="password" 
                           class="form-control" 
                           placeholder="Password" 
                           autocomplete="current-password"
                           >
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </div>
                    </div>
                </div>

                <!-- Submit Button with loading state -->
                <div class="row">
                    <div class="col-12">
                        <button type="submit" 
                                class="btn btn-primary btn-block btn-login-modern" 
                                id="loginBtn">
                            <span class="btn-text">
                                <i class="fas fa-sign-in-alt mr-1"></i> Sign In
                            </span>
                            <span class="btn-spinner"></span>
                        </button>
                    </div>
                </div>

                <!-- optional extra link (for better UX on mobile - we don't remove original but add subtle link) -->
                <div class="row mt-3">
                    <div class="col-12 text-center">
                        <a href="#" class="text-sm text-muted"><i class="fas fa-key"></i> Forgot password?</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

   
    <script>
        (function() {
            'use strict';

            const loginForm = document.getElementById('loginForm');
            const loginBtn = document.getElementById('loginBtn');

            if (loginForm) {
                loginForm.addEventListener('submit', function(e) {
                    // Basic client-side validation (optional, but good for UX)
                    const emailInput = loginForm.querySelector('input[name="email"]');
                    const passwordInput = loginForm.querySelector('input[name="password"]');
                    let isValid = true;
                    
                    if (!emailInput.value.trim()) {
                        emailInput.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        emailInput.classList.remove('is-invalid');
                    }
                    
                    if (!passwordInput.value.trim()) {
                        passwordInput.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        passwordInput.classList.remove('is-invalid');
                    }
                    
                    if (!isValid) {
                        e.preventDefault();
                        // show temporary feedback (non-disruptive)
                        const alertContainer = document.getElementById('flashMessageContainer');
                        if (alertContainer && !alertContainer.querySelector('.alert')) {
                            const tempAlert = document.createElement('div');
                            tempAlert.className = 'alert alert-warning alert-custom alert-dismissible fade show';
                            tempAlert.role = 'alert';
                            tempAlert.innerHTML = 'Please fill in both email and password. <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>';
                            alertContainer.prepend(tempAlert);
                            setTimeout(() => {
                                if(tempAlert && tempAlert.remove) tempAlert.remove();
                            }, 3000);
                        }
                        return false;
                    }
                    
                    // if valid, show loading state on button and disable it
                    if (loginBtn) {
                        loginBtn.classList.add('loading');
                        loginBtn.disabled = true;
                    }
                    // allow form to submit normally (server-side processing)
                    return true;
                });
            }
            
            // Fix for any missing data-dismiss for dynamic alerts: bootstrap handles it via jQuery, but safe to reinitialize
            if (typeof $ !== 'undefined') {
                // ensure any close button works with dynamically added alerts? not needed, but ensures proper cleanup
                $(document).on('click', '[data-dismiss="alert"]', function(e) {
                    e.preventDefault();
                    $(this).closest('.alert').alert('close');
                });
            }
        })();
    </script>
    <!-- 
        ========== NOTE ON CSS DEDUPLICATION ==========
        - Removed ALL duplicate CSS rules that were already covered by AdminLTE:
          * .card border/radius (AdminLTE provides .card styles, we only added .card-custom)
          * .form-control base styles (AdminLTE normalizes and styles inputs)
          * .input-group-text background (retained minimal custom but removed conflicting overrides)
          * general background and fonts are inherited from AdminLTE + custom gradient for body
          * Removed redundant .login-box-msg because we use custom heading
          * Removed duplicate .btn classes and simplified to custom .btn-login-modern
          * Also removed extra .btn-primary overrides to avoid conflicts
          * Icon backgrounds unified, no repetitive 'border-radius' collisions
          * Spinner and animation kept only in one custom block
          * Mobile fixes: we added explicit @media queries, ensure card width: 100% / max-width 480px,
            removed hardcoded width:40% style (was causing break on mobile). AdminLTE is fully responsive
            and combined with our viewport meta & flex centering delivers perfect mobile experience.
        - The final result retains all visual improvements (gradient, shadows, loading spinner) 
          but with ZERO duplication, max compatibility with AdminLTE ecosystem.
    -->
</body>
</html>
</body>
</html>
<div class="row">

    <div class="col-lg-12 offset-lg">

        <div class="card card-primary card-outline shadow">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-bed mr-2"></i>

                    <%= title %>

                </h3>

                <div class="card-tools">

                    <span class="badge badge-info">

                        Room Management

                    </span>

                </div>

            </div>

            <form
                method="POST"
                action="<%= room ? ('/rooms/' + room.id) : '/rooms' %>">

                <div class="card-body">

                    <!-- ROOM DETAILS -->
                    <div class="card card-light">

                        <div class="card-header">

                            <h3 class="card-title">

                                <i class="fas fa-door-open mr-2"></i>

                                Room Information

                            </h3>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label>

                                            Room Number

                                            <span class="text-danger">*</span>

                                        </label>

                                        <div class="input-group">

                                            <div class="input-group-prepend">

                                                <span class="input-group-text">

                                                    <i class="fas fa-hashtag"></i>

                                                </span>

                                            </div>

                                            <input
                                                type="text"
                                                id="roomNumber"
                                                name="roomNumber"
                                                value="<%= room ? room.roomNumber : '' %>"
                                                class="form-control"
                                                required>

                                        </div>

                                        <% if(errors && errors.roomNumber){ %>

                                            <small class="text-danger">

                                                <%= errors.roomNumber %>

                                            </small>

                                        <% } %>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label>

                                            Room Name

                                            <span class="text-danger">*</span>

                                        </label>

                                        <div class="input-group">

                                            <div class="input-group-prepend">

                                                <span class="input-group-text">

                                                    <i class="fas fa-bed"></i>

                                                </span>

                                            </div>

                                            <input
                                                type="text"
                                                id="roomName"
                                                name="roomName"
                                                value="<%= room ? room.roomName : '' %>"
                                                class="form-control"
                                                required>

                                        </div>

                                        <% if(errors && errors.roomName){ %>

                                            <small class="text-danger">

                                                <%= errors.roomName %>

                                            </small>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- PRICING -->
                    <div class="card card-success">

                        <div class="card-header">

                            <h3 class="card-title">

                                <i class="fas fa-money-bill-wave mr-2"></i>

                                Pricing & Discount

                            </h3>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label>

                                            Price Per Night

                                        </label>

                                        <div class="input-group">

                                            <div class="input-group-prepend">

                                                <span class="input-group-text">

                                                    ₦

                                                </span>

                                            </div>

                                            <input
                                                type="number"
                                                id="price"
                                                name="price"
                                                value="<%= room ? room.price : '' %>"
                                                class="form-control"
                                                min="0"
                                                step="0.01"
                                                required>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label>

                                            Discount

                                        </label>

                                        <select
                                            id="discount"
                                            name="discount"
                                            class="form-control">

                                            <option value="0">No Discount</option>

                                            <% for(let i=1;i<=30;i++){ %>

                                                <option
                                                    value="<%= i %>"
                                                    <%= room && Number(room.discount)===i ? 'selected' : '' %>>

                                                    <%= i %> %

                                                </option>

                                            <% } %>

                                        </select>

                                    </div>

                                </div>

                            </div>

                            <div class="alert alert-info">

                                <strong>

                                    Final Price:

                                </strong>

                                ₦<span id="finalPrice">0.00</span>

                            </div>

                        </div>

                    </div>

                    <!-- AMENITIES -->
                    <div class="card card-info">

                        <div class="card-header">

                            <h3 class="card-title">

                                <i class="fas fa-concierge-bell mr-2"></i>

                                Amenities

                            </h3>

                        </div>

                        <div class="card-body">

                            <textarea
                                id="amenities"
                                name="amenities"
                                rows="5"
                                class="form-control"
                                placeholder="WiFi, Smart TV, Air Conditioning, Mini Bar..."><%= room ? room.amenities : '' %></textarea>

                        </div>

                    </div>

                    <!-- PREVIEW -->
                    <div class="card card-warning">

                        <div class="card-header">

                            <h3 class="card-title">

                                <i class="fas fa-eye mr-2"></i>

                                Room Preview

                            </h3>

                        </div>

                        <div class="card-body">

                            <h4 id="previewName">

                                Room Name

                            </h4>

                            <p>

                                Room No:
                                <strong id="previewNumber">

                                    -

                                </strong>

                            </p>

                            <p>

                                Nightly Rate:
                                <strong>

                                    ₦<span id="previewPrice">0</span>

                                </strong>

                            </p>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        <i class="fas fa-save mr-1"></i>

                        <%= room ? 'Update Room' : 'Create Room' %>

                    </button>

                    <a
                        href="/rooms"
                        class="btn btn-secondary">

                        <i class="fas fa-times mr-1"></i>

                        Cancel

                    </a>

                    <% if(room){ %>

                        <button
                            type="submit"
                            formaction="/rooms/<%= room.id %>/delete"
                            formmethod="POST"
                            onclick="return confirm('Delete this room?')"
                            class="btn btn-danger float-right">

                            <i class="fas fa-trash"></i>

                            Delete

                        </button>

                    <% } %>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

function updatePreview(){

    const roomName =
        document.getElementById('roomName').value;

    const roomNumber =
        document.getElementById('roomNumber').value;

    const price =
        parseFloat(
            document.getElementById('price').value
        ) || 0;

    const discount =
        parseFloat(
            document.getElementById('discount').value
        ) || 0;

    const finalPrice =
        price - (price * discount / 100);

    document.getElementById('previewName').innerText =
        roomName || 'Room Name';

    document.getElementById('previewNumber').innerText =
        roomNumber || '-';

    document.getElementById('previewPrice').innerText =
        finalPrice.toLocaleString();

    document.getElementById('finalPrice').innerText =
        finalPrice.toLocaleString();
}

document.addEventListener('DOMContentLoaded', function(){

    updatePreview();

    [
        'roomName',
        'roomNumber',
        'price',
        'discount'
    ].forEach(function(id){

        document
            .getElementById(id)
            .addEventListener(
                'input',
                updatePreview
            );

    });

});

</script>
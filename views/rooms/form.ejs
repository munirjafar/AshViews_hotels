<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0"><%= title %></h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/rooms">Rooms</a></li>
          <li class="breadcrumb-item active"><%= title %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<div class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <div class="card card-primary">
          <div class="card-header">
            <h3 class="card-title"><%= title %></h3>
          </div>
          <form method="POST" action="<%= room ? ('/rooms/' + room.id) : '/rooms' %>">
            <div class="card-body">
              <div class="form-group">
                <label for="roomNumber">Room Number <span class="text-danger">*</span></label>
                <input type="text" id="roomNumber" name="roomNumber" value="<%= room ? room.roomNumber : '' %>" class="form-control form-control-border" required>
                <% if (errors && errors.roomNumber) { %>
                  <small class="text-danger"><%= errors.roomNumber %></small>
                <% } %>
              </div>

              <div class="form-group">
                <label for="roomName">Room Name <span class="text-danger">*</span></label>
                <input type="text" id="roomName" name="roomName" value="<%= room ? room.roomName : '' %>" class="form-control form-control-border" required>
                <% if (errors && errors.roomName) { %>
                  <small class="text-danger"><%= errors.roomName %></small>
                <% } %>
              </div>

              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="price">Price (₦) <span class="text-danger">*</span></label>
                  <input type="number" id="price" name="price" value="<%= room ? room.price : '' %>" class="form-control form-control-border" min="0" step="0.01" required>
                  <% if (errors && errors.price) { %>
                    <small class="text-danger"><%= errors.price %></small>
                  <% } %>
                </div>
                <div class="col-md-6 form-group">
                  <label for="discount">Discount (%)</label>
                  <select id="discount" name="discount" class="form-control form-control-border">
                    <option value="0" <%= (!room || room.discount==0) ? 'selected' : '' %>>None</option>
                    <% for (let i = 1; i <= 30; i++) { %>
                      <option value="<%= i %>" <%= room && Number(room.discount)===i ? 'selected' : '' %>><%= i %> %</option>
                    <% } %>
                  </select>
                  <% if (errors && errors.discount) { %>
                    <small class="text-danger"><%= errors.discount %></small>
                  <% } %>
                </div>
              </div>

              <div class="form-group">
                <label for="amenities">Amenities</label>
                <textarea id="amenities" name="amenities" rows="3" class="form-control form-control-border"><%= room ? room.amenities : '' %></textarea>
              </div>
            </div>
            <div class="card-footer text-right">
              <button type="submit" class="btn btn-primary"><%= room ? 'Update Room' : 'Create Room' %></button>
              <a href="/rooms" class="btn btn-default ml-2">Cancel</a>
              <% if (room) { %>
                <form method="POST" action="/rooms/<%= room.id %>/delete" style="display:inline-block; margin-left:8px;">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              <% } %>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  form.addEventListener('submit', function(e) {
    const roomNumber = document.getElementById('roomNumber').value.trim();
    const roomName = document.getElementById('roomName').value.trim();
    const price = Number(document.getElementById('price').value);
    let clientErrors = [];
    if (!roomNumber) clientErrors.push('Room number is required');
    if (!roomName || roomName.length < 2) clientErrors.push('Room name is required');
    if (isNaN(price) || price <= 0) clientErrors.push('Price must be a positive number');
    if (clientErrors.length) {
      e.preventDefault();
      alert(clientErrors.join('\n'));
    }
  });
});
</script>

